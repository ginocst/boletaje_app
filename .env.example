# Esto es un ejemplo del archivo .env original. Este archivo no debe publicarse en github
# ya que contiene credenciales

# Clave secreta de Django. Generar con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# True en el PC de desarrollo
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
DB_NAME=boletaje_db
DB_USER=boletaje_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432